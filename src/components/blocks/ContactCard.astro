---
import contact from '@/content/settings/contact.json';
import ContactInfoList from '@/components/ContactInfoList.astro';

interface Props {
  showConfidentiality?: boolean;
}
const { showConfidentiality } = Astro.props;
---

<section class="py-10">
  <div class="container-prose">
    <div class="rounded-2xl border border-[var(--color-border)] bg-[var(--color-secondary)]/40 p-8 max-w-lg">
      <h2 class="font-display text-2xl font-medium mb-6">Kontaktuppgifter</h2>
      <ContactInfoList contact={contact} variant="card" />
      {showConfidentiality && contact.confidentiality && (
        <p class="mt-6 pt-5 border-t border-[var(--color-border)] text-sm text-[var(--color-muted-foreground)]">
          {contact.confidentiality}
        </p>
      )}
    </div>
  </div>
</section>
