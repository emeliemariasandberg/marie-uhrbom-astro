---
import { marked } from 'marked';
import contact from '@/content/settings/contact.json';
import ContactInfoList from '@/components/ContactInfoList.astro';

interface Props {
  id?: string;
  body: string;
  area?: string;
}
const { id, body, area } = Astro.props;
const bodyHtml = marked.parse(body);
---

<section id={id} class="py-16 md:py-20">
  <div class="container-prose">
    <div class="grid grid-cols-1 lg:grid-cols-3 gap-10">
      <div class="lg:col-span-2 prose-warm" set:html={bodyHtml} />

      <aside class="rounded-2xl border border-[var(--color-border)] bg-[var(--color-secondary)]/40 p-6 h-fit">
        <h3 class="font-display text-lg font-medium mb-4">Kontaktuppgifter</h3>
        <ContactInfoList contact={contact} variant="sidebar" />
      </aside>
    </div>
  </div>
</section>
