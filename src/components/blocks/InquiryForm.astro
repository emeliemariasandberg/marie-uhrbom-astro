---
import contact from '@/content/settings/contact.json';

interface Props {
  id?: string;
  eyebrow?: string;
  title?: string;
  intro?: string;
  area?: string;
  showSubject?: boolean;
  nameLabel?: string;
  emailLabel?: string;
  messageLabel?: string;
  subjectLabel?: string;
  messagePlaceholder?: string;
  submitLabel?: string;
  noteText?: string;
}
const {
  id,
  eyebrow,
  title,
  intro,
  area = 'general',
  showSubject = true,
  nameLabel = 'Namn',
  emailLabel = 'E-post',
  messageLabel = 'Meddelande',
  subjectLabel = 'Ämne',
  messagePlaceholder = 'Ditt meddelande…',
  submitLabel = 'Skicka',
  noteText = `Ett mail till mig öppnas i din e-post, redan ifyllt och klart att skicka. Händer inget kan du också höra av dig direkt på ${contact.email}.`,
} = Astro.props;

const formId = `inquiry-form-${Math.random().toString(36).slice(2, 7)}`;

const areaLabel = {
  homeopati: 'Homeopati',
  coachning: 'Hälsa & Livscoachning',
  hantverk:  'Läderhantverk',
}[area] ?? 'Förfrågan';
---

<section id={id} class="py-16 md:py-20">
  <div class="container-prose max-w-2xl">
    {eyebrow && <p class="eyebrow mb-3">{eyebrow}</p>}
    {title && <h2 class="font-display text-3xl md:text-4xl font-medium leading-tight mb-4">{title}</h2>}
    {intro && <p class="text-[var(--color-muted-foreground)] leading-relaxed mb-8">{intro}</p>}

    <form id={formId} class="space-y-5">
      <div class="grid grid-cols-1 sm:grid-cols-2 gap-5">
        <div>
          <label for={`${formId}-name`} class="block text-sm font-medium mb-1.5">
            {nameLabel} <span class="text-[var(--color-destructive)]">*</span>
          </label>
          <input
            id={`${formId}-name`}
            name="name"
            type="text"
            required
            aria-required="true"
            autocomplete="name"
            class="w-full px-3.5 py-2.5 rounded-lg border border-[var(--color-input)] bg-[var(--color-card)] text-sm focus:outline-none focus:ring-2 focus:ring-[var(--color-ring)] focus:ring-offset-1 transition-shadow"
          />
        </div>
        <div>
          <label for={`${formId}-email`} class="block text-sm font-medium mb-1.5">
            {emailLabel} <span class="text-[var(--color-destructive)]">*</span>
          </label>
          <input
            id={`${formId}-email`}
            name="email"
            type="email"
            required
            aria-required="true"
            autocomplete="email"
            class="w-full px-3.5 py-2.5 rounded-lg border border-[var(--color-input)] bg-[var(--color-card)] text-sm focus:outline-none focus:ring-2 focus:ring-[var(--color-ring)] focus:ring-offset-1 transition-shadow"
          />
        </div>
      </div>

      {showSubject && (
        <div>
          <label for={`${formId}-subject`} class="block text-sm font-medium mb-1.5">
            {subjectLabel}
          </label>
          <input
            id={`${formId}-subject`}
            name="subject"
            type="text"
            class="w-full px-3.5 py-2.5 rounded-lg border border-[var(--color-input)] bg-[var(--color-card)] text-sm focus:outline-none focus:ring-2 focus:ring-[var(--color-ring)] focus:ring-offset-1 transition-shadow"
          />
        </div>
      )}

      <div>
        <label for={`${formId}-message`} class="block text-sm font-medium mb-1.5">
          {messageLabel} <span class="text-[var(--color-destructive)]">*</span>
        </label>
        <textarea
          id={`${formId}-message`}
          name="message"
          required
          aria-required="true"
          rows="5"
          placeholder={messagePlaceholder}
          class="w-full px-3.5 py-2.5 rounded-lg border border-[var(--color-input)] bg-[var(--color-card)] text-sm focus:outline-none focus:ring-2 focus:ring-[var(--color-ring)] focus:ring-offset-1 transition-shadow resize-y"
        ></textarea>
      </div>

      <button
        type="submit"
        class="inline-flex items-center gap-2 px-8 py-3 rounded-lg bg-[var(--color-primary)] text-[var(--color-primary-foreground)] font-medium text-sm hover:opacity-90 transition-opacity shadow-[var(--shadow-soft)] cursor-pointer"
      >
        {submitLabel}
      </button>

      {noteText && <p class="text-xs text-[var(--color-muted-foreground)] leading-relaxed">{noteText}</p>}
    </form>
  </div>
</section>

<script define:vars={{ formId, contactEmail: contact.email, areaLabel, showSubject }}>
(function () {
  const form = document.getElementById(formId);
  if (!form) return;

  form.addEventListener('submit', (e) => {
    e.preventDefault();

    const name    = form.querySelector('[name="name"]')?.value?.trim()    ?? '';
    const email   = form.querySelector('[name="email"]')?.value?.trim()   ?? '';
    const subject = showSubject ? (form.querySelector('[name="subject"]')?.value?.trim() ?? '') : '';
    const message = form.querySelector('[name="message"]')?.value?.trim() ?? '';

    const mailSubject = subject ? `[${areaLabel}] ${subject}` : `[${areaLabel}] Förfrågan via marieuhrbom.se`;

    const bodyLines = [`Namn: ${name}`, `E-post: ${email}`];
    if (subject) bodyLines.push(`Ämne: ${subject}`);
    bodyLines.push('', message);

    const mailtoUrl =
      `mailto:${contactEmail}` +
      `?subject=${encodeURIComponent(mailSubject)}` +
      `&body=${encodeURIComponent(bodyLines.join('\n'))}`;

    window.location.href = mailtoUrl;
  });
})();
</script>
